# Supabase leaderboard (see supabase/schema.sql). The deployed values live in
# .env.production; copy this to .env.local to point local development at a
# project. Use the anon / publishable key, never the service_role / secret key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
