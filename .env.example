# Supabase leaderboard (see supabase/schema.sql). Copy to .env.local for local
# development; on GitHub Pages they come from the repository variables of the
# same names (Settings > Secrets and variables > Actions > Variables).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
